        if Client.Character and OriginalValues.WalkSpeed then
            local humanoid = Client.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.WalkSpeed = OriginalValues.WalkSpeed
            end
        end
    end
end

-- JumpPower modifier - ONLY runs when enabled
function ClientModsSystem.UpdateJumpPower()
    -- Cancel any existing loop
    if ActiveLoops.JumpPower then
        task.cancel(ActiveLoops.JumpPower)
        ActiveLoops.JumpPower = nil
    end
    
    if Config.ClientMods.JumpPower.Enabled then
        -- Start loop ONLY when feature is enabled
        ActiveLoops.JumpPower = task.spawn(function()
            while Config.ClientMods.JumpPower.Enabled do
                task.wait(0.1)
                if Client.Character then
                    local humanoid = Client.Character:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        humanoid.JumpPower = Config.ClientMods.JumpPower.Value
                    end
                end
            end
        end)
    else
        -- Restore original value when disabled
        if Client.Character and OriginalValues.JumpPower then
            local humanoid = Client.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.JumpPower = OriginalValues.JumpPower
            end
        end
    end
end

-- Fly system
function ClientModsSystem.StartFly()
    if FlyState.Flying then return end
    FlyState.Flying = true
    
    local humanoidRootPart = Client.Character and Client.Character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then return end
    
    -- Create BodyVelocity
    FlyState.BodyVelocity = Instance.new("BodyVelocity")
    FlyState.BodyVelocity.Velocity = Vector3.new(0, 0, 0)
    FlyState.BodyVelocity.MaxForce = Vector3.new(9e4, 9e4, 9e4)
    FlyState.BodyVelocity.Parent = humanoidRootPart
    
    -- Create BodyGyro
    FlyState.BodyGyro = Instance.new("BodyGyro")
    FlyState.BodyGyro.P = 9e4
    FlyState.BodyGyro.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
    FlyState.BodyGyro.CFrame = humanoidRootPart.CFrame
    FlyState.BodyGyro.Parent = humanoidRootPart
    
    -- Fly loop
    task.spawn(function()
        while FlyState.Flying and Config.ClientMods.Fly.Enabled do
            task.wait()
            
            if not Client.Character or not Client.Character:FindFirstChild("HumanoidRootPart") then
                ClientModsSystem.StopFly()
                break
            end
            
            local hrp = Client.Character.HumanoidRootPart
            local camera = workspace.CurrentCamera
            local speed = Config.ClientMods.Fly.Speed
            
            -- Get movement direction
            local moveVector = Vector3.new(0, 0, 0)
            
            if Services.UserInput:IsKeyDown(Enum.KeyCode.W) then
                moveVector = moveVector + camera.CFrame.LookVector
            end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.S) then
                moveVector = moveVector - camera.CFrame.LookVector
            end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.A) then
                moveVector = moveVector - camera.CFrame.RightVector
            end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.D) then
                moveVector = moveVector + camera.CFrame.RightVector
            end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.Space) then
                moveVector = moveVector + Vector3.new(0, 1, 0)
            end
            if Services.UserInput:IsKeyDown(Enum.KeyCode.LeftShift) then
                moveVector = moveVector - Vector3.new(0, 1, 0)
            end
            
            -- Apply velocity
            if FlyState.BodyVelocity then
                FlyState.BodyVelocity.Velocity = moveVector * speed
            end
            
            -- Update gyro
            if FlyState.BodyGyro then
                FlyState.BodyGyro.CFrame = camera.CFrame
            end
        end
    end)
end

function ClientModsSystem.StopFly()
    FlyState.Flying = false
    
    if FlyState.BodyVelocity then
        FlyState.BodyVelocity:Destroy()
        FlyState.BodyVelocity = nil
    end
    
    if FlyState.BodyGyro then
        FlyState.BodyGyro:Destroy()
        FlyState.BodyGyro = nil
    end
end

function ClientModsSystem.ToggleFly()
    if Config.ClientMods.Fly.Enabled then
        ClientModsSystem.StartFly()
    else
        ClientModsSystem.StopFly()
    end
end

-- Noclip system - ONLY runs when enabled
function ClientModsSystem.UpdateNoclip()
    -- Cancel any existing loop
    if ActiveLoops.Noclip then
        task.cancel(ActiveLoops.Noclip)
        ActiveLoops.Noclip = nil
    end
    
    if Config.ClientMods.Noclip.Enabled then
        -- Start loop ONLY when feature is enabled
        ActiveLoops.Noclip = task.spawn(function()
            while Config.ClientMods.Noclip.Enabled do
                task.wait()
                if Client.Character then
                    for _, part in pairs(Client.Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end
        end)
    end
    -- Note: When disabled, collision will naturally restore on next physics update
end

-- Infinite Jump
function ClientModsSystem.SetupInfiniteJump()
    Services.UserInput.JumpRequest:Connect(function()
        if Config.ClientMods.InfiniteJump.Enabled and Client.Character then
            local humanoid = Client.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end)
end

-- Initialize all client mods
function ClientModsSystem.Initialize()
    -- Wait for character to exist
    if not Client.Character then
        Client.Player.CharacterAdded:Wait()
    end
    
    -- STEP 1: Cache original values FIRST
    task.wait(0.5) -- Wait for humanoid to fully load
    ClientModsSystem.CacheOriginalValues()
    
    -- STEP 2: Restore original values immediately (in case of saved configs)
    ClientModsSystem.RestoreOriginalValues()
    
    -- STEP 3: Setup systems that don't auto-apply values
    ClientModsSystem.SetupInfiniteJump()
    
    -- STEP 4: Do NOT call UpdateWalkSpeed() or UpdateJumpPower() here
    -- These will be called ONLY when the user enables the features via UI toggle
    
    -- Handle character respawn
    Client.Player.CharacterAdded:Connect(function(char)
        -- Clean up fly state
        FlyState.Flying = false
        FlyState.BodyVelocity = nil
        FlyState.BodyGyro = nil
        
        -- Cancel all active loops
        if ActiveLoops.WalkSpeed then
            task.cancel(ActiveLoops.WalkSpeed)
            ActiveLoops.WalkSpeed = nil
        end
        if ActiveLoops.JumpPower then
            task.cancel(ActiveLoops.JumpPower)
            ActiveLoops.JumpPower = nil
        end
        if ActiveLoops.Noclip then
            task.cancel(ActiveLoops.Noclip)
            ActiveLoops.Noclip = nil
        end
        
        -- Wait for new character to load
        task.wait(0.5)
        
        -- Cache NEW character's original values
        ClientModsSystem.CacheOriginalValues()
        
        -- Restore original values (default state)
        ClientModsSystem.RestoreOriginalValues()
        
        -- ONLY re-apply features if they were explicitly enabled by user
        if Config.ClientMods.WalkSpeed.Enabled then
            ClientModsSystem.UpdateWalkSpeed()
        end
        
        if Config.ClientMods.JumpPower.Enabled then
            ClientModsSystem.UpdateJumpPower()
        end
        
        if Config.ClientMods.Fly.Enabled then
            ClientModsSystem.StartFly()
        end
        
        if Config.ClientMods.Noclip.Enabled then
            ClientModsSystem.UpdateNoclip()
        end
    end)
end


local ConfigSystem = {}

function ConfigSystem.Load()
    local success, data = pcall(function()
        return Services.HttpService:JSONDecode(readfile("syntrix_v2_config.json"))
    end)
    
    if success and data then
        Config.Aimbot = data.Aimbot or Config.Aimbot
        Config.Triggerbot = data.Triggerbot or Config.Triggerbot
        Config.ESP = data.ESP or Config.ESP
        Config.Filters = data.Filters or Config.Filters
        Config.FOV = data.FOV or Config.FOV
        Config.AntiAFK = data.AntiAFK or Config.AntiAFK
        Config.ClientMods = data.ClientMods or Config.ClientMods
        
        -- ✅ Apply loaded movement configs if enabled
        if Config.ClientMods.WalkSpeed.Enabled then
            ClientModsSystem.UpdateWalkSpeed()
        end
        
        if Config.ClientMods.JumpPower.Enabled then
            ClientModsSystem.UpdateJumpPower()
        end
        
        if Config.ClientMods.Noclip.Enabled then
            ClientModsSystem.UpdateNoclip()
        end
        
        if Config.ClientMods.Fly.Enabled then
            ClientModsSystem.StartFly()
        end
        
        return true
    end
    return false
end


