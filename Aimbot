local ClientModsSystem = {}

-- Fly state
local FlyState = {
    Flying = false,
    BodyVelocity = nil,
    BodyGyro = nil,
}

-- Original values cache (stores player's actual default values)
local OriginalValues = {
    WalkSpeed = nil,
    JumpPower = nil,
}

-- Active loop tracking (so we can cancel them when features are disabled)
local ActiveLoops = {
    WalkSpeed = nil,
    JumpPower = nil,
    Noclip = nil,
}

-- Cache original humanoid values on character spawn
function ClientModsSystem.CacheOriginalValues()
    if Client.Character then
        local humanoid = Client.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            -- Store the actual default values from the game
            OriginalValues.WalkSpeed = humanoid.WalkSpeed
            OriginalValues.JumpPower = humanoid.JumpPower
        end
    end
end

-- Restore original values (called when features are disabled or on cleanup)
function ClientModsSystem.RestoreOriginalValues()
    if Client.Character and OriginalValues.WalkSpeed and OriginalValues.JumpPower then
        local humanoid = Client.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = OriginalValues.WalkSpeed
            humanoid.JumpPower = OriginalValues.JumpPower
        end
    end
end

-- WalkSpeed modifier - ONLY runs when enabled
function ClientModsSystem.UpdateWalkSpeed()
    -- Cancel any existing loop
    if ActiveLoops.WalkSpeed then
        task.cancel(ActiveLoops.WalkSpeed)
        ActiveLoops.WalkSpeed = nil
    end
    
    if Config.ClientMods.WalkSpeed.Enabled then
        -- Start loop ONLY when feature is enabled
        ActiveLoops.WalkSpeed = task.spawn(function()
            while Config.ClientMods.WalkSpeed.Enabled do
                task.wait(0.1)
                if Client.Character then
                    local humanoid = Client.Character:FindFirstChildOfClass("Humanoid")
                    if humanoid then
